# Line endings
* text=auto

# Left out of dist archives (composer --prefer-dist, git archive): tests, test tooling,
# development scripts and the reference agent's end-to-end suite. Docs, config, migrations,
# views, routes, src/ and the agent SDK files (agent/package.json "files") ship.
/.gitattributes             export-ignore
/.gitignore                 export-ignore
/.github                    export-ignore
/phpunit.xml                export-ignore
/phpunit.phar               export-ignore
/tests                      export-ignore
/bin/test.sh                export-ignore
/bin/dev-install.sh         export-ignore
/bin/demo-seed.sh           export-ignore
/agent/*.test.mjs           export-ignore
/agent/e2e.mjs              export-ignore
/agent/mock-df.mjs          export-ignore
/agent/reference.json        export-ignore
/agent/DEVELOPMENT.md        export-ignore
/agent/.keys.json           export-ignore
/agent/.tokens.json         export-ignore
/clients/python/tests       export-ignore
